# H Company Models API (https://hub.hcompany.ai/) — bearer key. HAI_API_KEY is also accepted.
H_API_KEY=
# Gladia speech-to-text (https://app.gladia.io/). Optional: without it, you type your request in the bubble instead of speaking.
GLADIA_API_KEY=

# Optional overrides
# UNDO_LANG=fr                     # on-screen text in French; English by default
# UNDO_MODEL=holo4-35b-a3b          # executor (grounding loop): fastest Holo; or holo3-1-35b-a3b (free tier)
# UNDO_ANALYZER_MODEL=holo4-35b-a3b # analyzer ("brain", 1 call on 5 screenshots): fastest and most reliable in our benchmark; holo4-27b also works but is slower
# UNDO_ANALYZER_EFFORT=medium       # holo4-27b only: low | medium | xhigh
# UNDO_HOTKEY=double:shift         # two taps on ⇧; or double:alt, double:cmd, double:alt_r, <cmd>+<shift>+<alt>+z
# UNDO_BUFFER_MINUTES=480
# UNDO_CAPTURE_INTERVAL=1.5
# UNDO_DATA_DIR=~/.undo
# UNDO_EXCLUDED_APPS=1Password,Keychain Access,Trousseau d'accès,Passwords
# UNDO_INPUT_LOG=1                  # local keyboard/click log (never in password fields)
# UNDO_LOCK_INPUT=1                 # block the user's keyboard/mouse while Undo acts (ESC still stops)
# UNDO_GLOW=1                       # Siri-like glow + banner while Undo acts
# UNDO_REDACT=1                    # blur card numbers / IBANs / API keys in images before they are sent to H (one extra OCR pass per image)
# UNDO_CONFIRM=1                   # ask before destructive-looking clicks (supprimer, envoyer, payer…); off by default
